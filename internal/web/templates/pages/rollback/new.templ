package rollback

import "github.com/fr4nsys/usulnet/internal/web/templates/layouts"

type NewData struct {
	PageData layouts.PageData
	Form     FormData
}

templ New(data NewData) {
	@layouts.Base(data.PageData) {
		<div class="space-y-6">
			<div>
				<a href="/rollback" class="text-sm text-gray-400 hover:text-white">
					<i aria-hidden="true" class="fas fa-chevron-left mr-1"></i>back to policies
				</a>
				<h1 class="text-2xl font-display font-bold text-white mt-1">New rollback policy</h1>
				<p class="text-gray-400 mt-1">Define how usulnet should react when a stack deploy fails.</p>
			</div>
			@PolicyForm(data.Form)
		</div>
	}
}
