package rollback

// PolicyView is the template-side projection of models.RollbackPolicy.
// The web handler's adapter populates this from the service result so
// the templ files do not import internal/models directly.
type PolicyView struct {
	ID               string
	Name             string
	Description      string
	Enabled          bool
	Scope            string
	ScopeStackID     string
	ScopeStackName   string
	ScopeValue       string
	TriggerKind      string
	LastGoodStrategy string
	CooldownSeconds  int
	DryRun           bool
	CreatedAt        string
}

templ PolicyCard(p PolicyView) {
	<div class="card p-4 hover:bg-dark-700/40 transition-colors">
		<div class="flex items-start justify-between">
			<div class="flex-1 min-w-0">
				<div class="flex items-center gap-2 mb-1">
					<a href={ templ.SafeURL("/rollback/" + p.ID) } class="text-base font-semibold text-white hover:text-primary-400 truncate">
						{ p.Name }
					</a>
					if p.Enabled {
						<span class="text-xs px-2 py-0.5 rounded bg-green-500/20 text-green-300">enabled</span>
					} else {
						<span class="text-xs px-2 py-0.5 rounded bg-gray-500/20 text-gray-300">disabled</span>
					}
					if p.DryRun {
						<span class="text-xs px-2 py-0.5 rounded bg-blue-500/20 text-blue-300">dry-run</span>
					}
				</div>
				if p.Description != "" {
					<p class="text-sm text-gray-400 mb-2 line-clamp-2">{ p.Description }</p>
				}
				<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-gray-500">
					<span><i class="fas fa-bullseye mr-1"></i>scope: { p.Scope }
						if p.Scope == "stack" && p.ScopeStackName != "" {
							: { p.ScopeStackName }
						} else if p.Scope == "tag" {
							: { p.ScopeValue }
						}
					</span>
					<span><i class="fas fa-bolt mr-1"></i>trigger: { p.TriggerKind }</span>
					<span><i class="fas fa-undo mr-1"></i>strategy: { p.LastGoodStrategy }</span>
					if p.CooldownSeconds > 0 {
						<span><i class="fas fa-hourglass-half mr-1"></i>cooldown: { itoaPad(p.CooldownSeconds) }s</span>
					}
				</div>
			</div>
			<div class="flex items-center gap-2 ml-4 flex-shrink-0">
				<a href={ templ.SafeURL("/rollback/" + p.ID + "/edit") } class="btn-secondary text-xs px-3 py-1.5" title="Edit">
					<i class="fas fa-pen"></i>
				</a>
				<a href={ templ.SafeURL("/rollback/" + p.ID + "/dry-run") } class="btn-secondary text-xs px-3 py-1.5" title="Dry-run">
					<i class="fas fa-vial"></i>
				</a>
			</div>
		</div>
	</div>
}

