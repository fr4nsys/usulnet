package dns

import "github.com/fr4nsys/usulnet/internal/web/templates/layouts"

templ Supported(data CapabilityPageData) {
	@layouts.Base(data.PageData) {
		<div class="space-y-6">
			<div>
				<h1 class="text-2xl font-display font-bold text-white">Provider Capability Matrix</h1>
				<p class="text-gray-400 mt-1">Bundled DNS plugins and the record types each one can read and write.</p>
			</div>
			@Nav("supported")

			for _, c := range data.Capabilities {
				@capabilityCard(c)
			}

			if len(data.Capabilities) == 0 {
				<div class="card p-8 text-center">
					<p class="text-gray-400">No DNS provider plugins are bundled in this build.</p>
				</div>
			}
		</div>
	}
}

templ capabilityCard(c CapabilityView) {
	<div class="card overflow-hidden">
		<div class="px-6 py-4 border-b border-dark-700">
			<h2 class="text-lg font-medium text-white">{ c.DisplayName }</h2>
			<p class="text-sm text-gray-400 mt-1">{ c.Description }</p>
		</div>
		<div class="overflow-x-auto">
			<table class="table">
				<thead>
					<tr><th>Record type</th><th>Read</th><th>Write</th><th>Update TTL</th></tr>
				</thead>
				<tbody>
					for _, rec := range c.Records {
						<tr>
							<td><span class="font-mono text-sm">{ rec.Type }</span></td>
							<td>
								if rec.Read {
									<i class="fas fa-check text-green-400"></i>
								} else {
									<i class="fas fa-times text-gray-600"></i>
								}
							</td>
							<td>
								if rec.Write {
									<i class="fas fa-check text-green-400"></i>
								} else {
									<i class="fas fa-times text-gray-600"></i>
								}
							</td>
							<td>
								if rec.UpdateTTL {
									<i class="fas fa-check text-green-400"></i>
								} else {
									<i class="fas fa-times text-gray-600"></i>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}
