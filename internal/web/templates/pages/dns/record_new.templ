package dns

import (
	"fmt"

	"github.com/fr4nsys/usulnet/internal/web/templates/layouts"
)

templ RecordNew(data RecordNewData) {
	@layouts.Base(data.PageData) {
		<div class="space-y-6">
			<div>
				<h1 class="text-2xl font-display font-bold text-white">New record</h1>
				<p class="text-gray-400 mt-1">Adding to <span class="text-white">{ data.Provider.Name }</span> ({ data.Selected.DisplayName })</p>
			</div>
			@Nav("records")

			<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/dns/%s/records", data.Provider.ID)) } class="card p-6 space-y-4">
				<input type="hidden" name="csrf_token" value={ data.PageData.CSRFToken }/>

				if data.Error != "" {
					<div class="rounded-lg bg-red-500/10 border border-red-500/30 text-red-300 p-3 text-sm">{ data.Error }</div>
				}

				<div>
					<label for="name" class="block text-sm font-medium text-gray-300 mb-1">Name (FQDN)</label>
					<input id="name" name="name" type="text" class="input w-full font-mono" required placeholder="app.example.com" aria-label="app.example.com"/>
				</div>

				<div>
					<label for="type" class="block text-sm font-medium text-gray-300 mb-1">Type</label>
					<select id="type" name="type" class="input w-full">
						for _, rec := range data.Selected.Records {
							if rec.Write {
								<option value={ rec.Type }>{ rec.Type }</option>
							}
						}
					</select>
				</div>

				<div>
					<label for="content" class="block text-sm font-medium text-gray-300 mb-1">Content</label>
					<input id="content" name="content" type="text" class="input w-full font-mono" required/>
				</div>

				<div>
					<label for="ttl" class="block text-sm font-medium text-gray-300 mb-1">TTL (seconds)</label>
					<input id="ttl" name="ttl" type="number" min="30" max="86400" value="300" class="input w-full"/>
				</div>

				<div class="flex items-center justify-end gap-2 pt-2">
					<a href={ templ.SafeURL(fmt.Sprintf("/dns/%s", data.Provider.ID)) } class="btn-secondary">Cancel</a>
					<button type="submit" class="btn-primary">Create</button>
				</div>
			</form>
		</div>
	}
}
