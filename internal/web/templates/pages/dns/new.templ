package dns

import "github.com/fr4nsys/usulnet/internal/web/templates/layouts"

templ ProviderNew(data ProviderFormData) {
	@layouts.Base(data.PageData) {
		<div class="space-y-6">
			<div>
				<h1 class="text-2xl font-display font-bold text-white">New DNS Provider</h1>
				<p class="text-gray-400 mt-1">Credentials are encrypted at rest with the installation AES key.</p>
			</div>
			@Nav("providers")
			@providerForm(data)
		</div>
	}
}

templ ProviderEdit(data ProviderFormData) {
	@layouts.Base(data.PageData) {
		<div class="space-y-6">
			<div>
				<h1 class="text-2xl font-display font-bold text-white">Edit DNS Provider</h1>
				<p class="text-gray-400 mt-1">Leave the credentials field empty to keep the existing token.</p>
			</div>
			@Nav("providers")
			@providerForm(data)
		</div>
	}
}
