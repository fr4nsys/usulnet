// Package onboarding hosts the v26.5.2 first-run wizard.
//
// Two screens, both rendered with AuthLayout (no sidebar) so the
// operator can't navigate away. Step 1 is mandatory — it changes the
// bootstrap admin password. Step 2 is informational: a "you're done"
// page with skippable secondary CTAs that link out to /hosts/new and
// /marketplace.
package onboarding

import "github.com/fr4nsys/usulnet/internal/web/templates/layouts"

// WelcomeData drives /onboarding/welcome — the mandatory
// password-change step. Username is read-only (always "admin" on a
// fresh install); the operator can't escape the wizard by retargeting
// it at a different account.
type WelcomeData struct {
	Username  string
	CSRFToken string
	Error     string
}

templ Welcome(data WelcomeData) {
	@layouts.AuthLayout("Set your admin password") {
		<div class="min-h-screen flex items-center justify-center bg-dark-900 px-4 py-8">
			<div class="w-full max-w-lg">
				<div class="text-center mb-8">
					<div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-primary-500 to-primary-600 mb-4 shadow-lg shadow-primary-500/25">
						<span class="text-black font-bold text-2xl font-display">U</span>
					</div>
					<h1 class="text-2xl font-bold font-display text-white">Welcome to usulnet</h1>
					<p class="text-sm text-gray-400 mt-2 max-w-md mx-auto">
						Before you start, set a real password for the admin account.
						The default credential <code class="text-primary-400">usulnet</code> is shipped
						with every install and assumed compromised on day one.
					</p>
				</div>

				<div class="card shadow-xl p-8">
					<div class="mb-6 flex items-start gap-3 p-3 rounded-lg bg-primary-500/10 border border-primary-500/20 text-primary-300 text-sm">
						<i aria-hidden="true" class="fas fa-shield-halved mt-0.5"></i>
						<div>
							Step 1 of 2. You can&rsquo;t reach the rest of the UI until
							the admin password is changed.
						</div>
					</div>

					if data.Error != "" {
						<div class="mb-6 p-4 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 text-sm flex items-start gap-3">
							<i aria-hidden="true" class="fas fa-exclamation-circle mt-0.5"></i>
							<span>{ data.Error }</span>
						</div>
					}

					<form method="POST" action="/onboarding/welcome" class="space-y-5">
						<input type="hidden" name="csrf_token" value={ data.CSRFToken }/>

						<div>
							<label for="username" class="block text-sm font-medium text-gray-300 mb-2">
								Admin username
							</label>
							<input
								type="text"
								id="username"
								value={ data.Username }
								readonly
								class="w-full px-4 py-3 rounded-lg bg-dark-800 border border-dark-600 text-gray-400 cursor-not-allowed"
							/>
						</div>

						<div>
							<label for="new_password" class="block text-sm font-medium text-gray-300 mb-2">
								New password
								<span class="text-xs text-gray-500 ml-1">(at least 12 characters)</span>
							</label>
							<input
								type="password"
								id="new_password"
								name="new_password"
								required
								minlength="12"
								autocomplete="new-password"
								autofocus
								class="w-full px-4 py-3 rounded-lg bg-dark-700 border border-dark-600 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500/50 focus:border-primary-500 transition-colors"
							/>
						</div>

						<div>
							<label for="confirm_password" class="block text-sm font-medium text-gray-300 mb-2">
								Confirm new password
							</label>
							<input
								type="password"
								id="confirm_password"
								name="confirm_password"
								required
								minlength="12"
								autocomplete="new-password"
								class="w-full px-4 py-3 rounded-lg bg-dark-700 border border-dark-600 text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-primary-500/50 focus:border-primary-500 transition-colors"
							/>
						</div>

						<button
							type="submit"
							class="w-full inline-flex items-center justify-center gap-2 px-4 py-3 bg-primary-500 hover:bg-primary-600 text-black font-semibold rounded-lg transition-colors"
						>
							<i aria-hidden="true" class="fas fa-arrow-right"></i>
							Continue
						</button>
					</form>
				</div>

				<p class="text-center text-xs text-gray-500 mt-6">
					Forgot something? You can re-run <code class="text-primary-400">usulnet admin reset-password</code> from the CLI.
				</p>
			</div>
		</div>
	}
}
