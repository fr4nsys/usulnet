package proxy

// BackendSupport is the per-feature support matrix surfaced in the UI.
// It is populated by web handlers from the proxy service's SupportMatrix().
type BackendSupport struct {
	Mode         string // "nginx", "caddy", "npm" — empty means unknown
	AccessLists  bool
	DeadHosts    bool
	Locations    bool
	Redirections bool
	Streams      bool
}

templ Nav(active string, connected bool) {
	<div class="border-b border-dark-700 mb-6">
		<nav class="flex gap-1 -mb-px overflow-x-auto">
			@navTab("/proxy", "Proxy Hosts", "fas fa-server", active == "hosts", connected)
			@navTab("/proxy/redirections", "Redirections", "fas fa-directions", active == "redirections", connected)
			@navTab("/proxy/streams", "Streams", "fas fa-stream", active == "streams", connected)
			@navTab("/proxy/dead-hosts", "404 Hosts", "fas fa-ban", active == "deadhosts", connected)
			@navTab("/proxy/certificates", "SSL Certificates", "fas fa-certificate", active == "certificates", connected)
			@navTab("/proxy/access-lists", "Access Lists", "fas fa-shield-alt", active == "accesslists", connected)
			@navTab("/proxy/audit", "Audit Log", "fas fa-history", active == "audit", connected)
		</nav>
	</div>
}

// SupportMatrixBanner renders a compact "what works where" badge row so
// the operator can see, before clicking into a tab, whether the active
// backend can actually apply the feature behind it.
//
// usulnet v26.5.1 supports two backends:
//   - nginx — full extended-feature support (the canonical/default)
//   - caddy — partial; streams are unsupported (raw TCP/UDP forwarding
//     has no native Caddy equivalent in v26.5.1)
templ SupportMatrixBanner(s BackendSupport) {
	<div class="mb-4 rounded border border-dark-700 bg-dark-800 px-4 py-3 text-xs text-gray-400">
		<div class="flex flex-wrap items-center gap-x-4 gap-y-1">
			<span class="font-medium text-gray-300">
				<i class="fas fa-server mr-1"></i>
				if s.Mode != "" {
					Active backend: <span class="text-primary-400">{ s.Mode }</span>
				} else {
					Active backend: <span class="text-gray-500">unknown</span>
				}
			</span>
			@supportBadge("Hosts", true)
			@supportBadge("Access lists", s.AccessLists)
			@supportBadge("404 hosts", s.DeadHosts)
			@supportBadge("Locations", s.Locations)
			@supportBadge("Redirections", s.Redirections)
			@supportBadge("Streams", s.Streams)
		</div>
		if !s.Streams {
			<div class="mt-2 text-amber-400">
				<i class="fas fa-info-circle mr-1"></i>
				Streams (raw TCP/UDP) cannot be applied with the active backend.
				Switch to nginx if you need this feature.
			</div>
		}
	</div>
}

templ supportBadge(label string, supported bool) {
	if supported {
		<span class="inline-flex items-center gap-1 rounded bg-green-900/40 px-2 py-0.5 text-green-300">
			<i class="fas fa-check text-[10px]"></i>
			{ label }
		</span>
	} else {
		<span class="inline-flex items-center gap-1 rounded bg-red-900/40 px-2 py-0.5 text-red-300">
			<i class="fas fa-times text-[10px]"></i>
			{ label }
		</span>
	}
}

templ navTab(href string, label string, icon string, isActive bool, enabled bool) {
	if enabled {
		<a
			href={ templ.SafeURL(href) }
			class={ "flex items-center gap-2 px-4 py-3 text-sm font-medium whitespace-nowrap border-b-2 transition-colors",
				templ.KV("border-primary-500 text-primary-400", isActive),
				templ.KV("border-transparent text-gray-400 hover:text-white hover:border-gray-600", !isActive) }
		>
			<i class={ icon }></i>
			{ label }
		</a>
	} else {
		<span class="flex items-center gap-2 px-4 py-3 text-sm font-medium whitespace-nowrap border-b-2 border-transparent text-gray-400 cursor-not-allowed">
			<i class={ icon }></i>
			{ label }
		</span>
	}
}
