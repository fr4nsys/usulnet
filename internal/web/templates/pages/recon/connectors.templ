package recon

import (
	"github.com/fr4nsys/usulnet/internal/web/templates/components"
	"github.com/fr4nsys/usulnet/internal/web/templates/layouts"
)

templ Connectors(data ConnectorsData) {
	@layouts.Base(data.PageData) {
		<div class="space-y-6">
			<div>
				<h1 class="text-2xl font-display font-bold text-white">Recon Connectors</h1>
				<p class="text-gray-400 mt-1">Optional API integrations. Disabled by default; require your own credentials.</p>
			</div>

			if len(data.Connectors) == 0 {
				@components.EmptyState("fa-plug", "", "No connectors registered.")
			} else {
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					for _, c := range data.Connectors {
						@connectorCard(c)
					}
				</div>
			}

			if len(data.SandboxTools) > 0 {
				<div class="space-y-3 pt-4 border-t border-dark-600">
					<div>
						<h2 class="text-xl font-display font-semibold text-white">Sandbox tools</h2>
						<p class="text-gray-400 mt-1 text-sm">
							Tools bundled in the <code class="text-primary-400">recon-toolkit</code> sandbox image. Available to SpiderFoot modules and to operator-initiated exec from scan detail pages.
						</p>
					</div>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						for _, g := range data.SandboxTools {
							@sandboxToolGroupCard(g)
						}
					</div>
				</div>
			}
		</div>
	}
}

templ sandboxToolGroupCard(g SandboxToolGroup) {
	<div class="card p-5">
		<div class="flex items-center gap-3 mb-3">
			<i aria-hidden="true" class="fas fa-screwdriver-wrench text-primary-400"></i>
			<h3 class="text-base font-display font-semibold text-white capitalize">{ g.Category }</h3>
		</div>
		<ul class="flex flex-wrap gap-2">
			for _, t := range g.Tools {
				<li class="px-2.5 py-1 rounded bg-dark-700 border border-dark-500 text-xs font-mono text-gray-200">
					{ t.Name }
				</li>
			}
		</ul>
	</div>
}

templ connectorCard(c ConnectorView) {
	<div class="card p-5">
		<div class="flex items-center justify-between mb-2">
			<div class="flex items-center gap-3">
				<i aria-hidden="true" class="fas fa-plug text-primary-400"></i>
				<h2 class="text-lg font-display font-semibold text-white">{ c.Name }</h2>
			</div>
			if c.Enabled {
				@components.Chip(components.ToneSuccess, "enabled")
			} else {
				@components.Chip(components.ToneNeutral, "disabled")
			}
		</div>
		<p class="text-sm text-gray-400">{ c.Description }</p>
		<form
			class="mt-4 space-y-2"
			hx-put={ "/api/v1/recon/connectors/" + c.Kind }
			hx-swap="none"
		>
			<label class="block text-xs text-gray-400">API Key</label>
			<input type="password" name="api_key" autocomplete="off" placeholder="paste your key" aria-label="paste your key" class="w-full bg-dark-700 border border-dark-500 rounded px-3 py-1.5 text-sm text-white"/>
			<div class="flex items-center justify-between mt-3">
				if c.DocsURL != "" {
					<a href={ templ.SafeURL(c.DocsURL) } target="_blank" rel="noopener" class="text-xs text-primary-400 hover:underline">
						<i aria-hidden="true" class="fas fa-external-link-alt mr-1"></i>API docs
					</a>
				} else {
					<span></span>
				}
				<button type="submit" class="btn-primary text-sm">Save</button>
			</div>
		</form>
	</div>
}
