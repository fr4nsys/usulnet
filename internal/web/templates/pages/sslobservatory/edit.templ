package sslobservatory

import (
	"fmt"
	"strings"

	"github.com/fr4nsys/usulnet/internal/web/templates/layouts"
)

type EditTargetData struct {
	PageData       layouts.PageData
	ID             string
	Name           string
	Hostname       string
	Port           int
	ExtraHostnames []string
	Thresholds     []int
	Enabled        bool
	Error          string
}

templ EditTarget(data EditTargetData) {
	@layouts.Base(data.PageData) {
		<div class="space-y-6">
			@Nav("targets")

			<div class="max-w-3xl">
				<div class="flex items-center gap-3 mb-6">
					<a href={ templ.SafeURL(fmt.Sprintf("/ssl/targets/%s", data.ID)) } class="text-gray-400 hover:text-white">
						<i class="fas fa-arrow-left"></i>
					</a>
					<h2 class="text-xl font-display font-bold text-white">Edit SSL Target</h2>
				</div>

				if data.Error != "" {
					<div class="bg-red-500/10 border border-red-500/20 rounded-lg p-4 mb-4">
						<p class="text-red-400 text-sm">{ data.Error }</p>
					</div>
				}

				<form method="POST" action={ templ.SafeURL(fmt.Sprintf("/ssl/targets/%s/edit", data.ID)) } class="space-y-4">
					<input type="hidden" name="csrf_token" value={ data.PageData.CSRFToken }/>

					<div>
						<label class="block text-sm font-medium text-gray-300 mb-1">Name</label>
						<input
							type="text"
							name="name"
							value={ data.Name }
							required
							class="w-full bg-dark-800 border border-dark-600 text-white rounded-lg px-3 py-2 focus:ring-2 focus:ring-accent-500 focus:border-transparent"
						/>
					</div>

					<div>
						<label class="block text-sm font-medium text-gray-300 mb-1">Hostname</label>
						<input
							type="text"
							name="hostname"
							value={ data.Hostname }
							required
							class="w-full bg-dark-800 border border-dark-600 text-white font-mono rounded-lg px-3 py-2 focus:ring-2 focus:ring-accent-500 focus:border-transparent"
						/>
					</div>

					<div>
						<label class="block text-sm font-medium text-gray-300 mb-1">Port</label>
						<input
							type="number"
							name="port"
							value={ fmt.Sprintf("%d", data.Port) }
							min="1"
							max="65535"
							class="w-full bg-dark-800 border border-dark-600 text-white font-mono rounded-lg px-3 py-2 focus:ring-2 focus:ring-accent-500 focus:border-transparent"
						/>
					</div>

					<div>
						<label class="block text-sm font-medium text-gray-300 mb-1">
							Extra SNI Hostnames
							<span class="text-xs text-gray-500 ml-1">(comma or newline separated)</span>
						</label>
						<textarea
							name="extra_hostnames"
							rows="3"
							class="w-full bg-dark-800 border border-dark-600 text-white font-mono rounded-lg px-3 py-2 focus:ring-2 focus:ring-accent-500 focus:border-transparent"
						>{ strings.Join(data.ExtraHostnames, "\n") }</textarea>
					</div>

					<div>
						<label class="block text-sm font-medium text-gray-300 mb-1">
							Alert Thresholds (days)
						</label>
						<input
							type="text"
							name="alert_thresholds"
							value={ joinInts(data.Thresholds) }
							placeholder="30,14,7,3,1"
							class="w-full bg-dark-800 border border-dark-600 text-white font-mono rounded-lg px-3 py-2 focus:ring-2 focus:ring-accent-500 focus:border-transparent"
						/>
					</div>

					<div>
						<label class="flex items-center gap-2 text-sm font-medium text-gray-300">
							<input
								type="checkbox"
								name="enabled"
								if data.Enabled {
									checked
								}
								class="rounded bg-dark-800 border-dark-600 text-accent-500 focus:ring-accent-500"
							/>
							Enabled
						</label>
					</div>

					<div class="flex gap-2 pt-4">
						<button type="submit" class="btn btn-primary">
							<i class="fas fa-save mr-1"></i> Save Changes
						</button>
						<a href={ templ.SafeURL(fmt.Sprintf("/ssl/targets/%s", data.ID)) } class="btn btn-secondary">Cancel</a>
					</div>
				</form>
			</div>
		</div>
	}
}
